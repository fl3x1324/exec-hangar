# Password for /admin, where you create per-player helper tokens. Long and random.
ADMIN_TOKEN=change-me
# Optional shared helper token (accepted alongside tokens created on /admin)
# HELPER_TOKEN=change-me-too
# docker compose: host port, and which interface to publish it on (default localhost only)
# PORT=3000
# BIND=127.0.0.1
# Where events.jsonl is stored (default ./data)
# DATA_DIR=./data
